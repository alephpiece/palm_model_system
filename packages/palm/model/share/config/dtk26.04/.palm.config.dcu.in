# BW-series DCUs / DTK 26.04 OpenACC build and run configuration.
# Default target: BW100 (gfx936); adjust --offload-arch for your DCU model.
# Replace @BUILD_ROOT@ and @SOURCE_ROOT@ with absolute paths, save as
# <build-root>/.palm.config.dcu, then run palmbuild -c dcu from that directory.
# Review dependency paths and local_username; see the adjacent README.md.

%base_directory      @BUILD_ROOT@
%base_data           @BUILD_ROOT@/JOBS
%source_path         @SOURCE_ROOT@/packages/palm/model/src
%user_source_path    @BUILD_ROOT@/JOBS/$run_identifier/USER_CODE
%fast_io_catalog     @BUILD_ROOT@/tmp
%restart_data_path   @BUILD_ROOT@/tmp
%output_data_path    @BUILD_ROOT@/JOBS
%local_jobcatalog    @BUILD_ROOT@/JOBS/$run_identifier/LOG_FILES
%local_ip            127.0.0.1
%local_hostname      master
%local_username      root
%c_compiler_name /usr/bin/gcc
%compiler_name /opt/mpi-flang/bin/mpifort
%compiler_name_ser /opt/dtk-26.04/llvm/bin/flang
%cpp_options -DPALM_FFT_TRANSPOSE_VECTOR64 -DPALM_FFT_TRANSPOSE_VECTOR64_REST -DPALM_FFT_LOCAL_ZX_FUSION -DPALM_FFT_LOCAL_MIDDLE_FUSION -DPALM_FFT_PACK_VECTOR64 -DPALM_TRIDIA_VECTOR64 -D__hip_fft -D__palm_ws_sharded_stats -DPALM_WS_MOMENTUM_SHARDS -DPALM_SURFACE_STATS_REDUCTION -DPALM_FLOW_FLUX_SHARDS -DPALM_FLOW_MIXED_SHARDS -DPALM_FLOW_HUMIDITY_SHARDS -DPALM_TKE_SHEAR_DIAGONAL -DPALM_FLOW_UVPT_SHARDS -DPALM_FLOW_ENERGY_SHARDS -DPALM_EQUATION_VECTOR64 -DPALM_PRESSURE_MEAN_SHARDS -DPALM_SOIL_CONDUCTIVITY_MAPPING -DPALM_TCM_DIFFUSIVITY_ORGANIZATION -DPALM_FLOW_ENERGY_MAPPING -DPALM_TKE_SHEAR_VECTOR64 -DPALM_Q_UPDATE_COLLAPSE3 -cpp -D__parallel -DMPI_REAL=MPI_DOUBLE_PRECISION -DMPI_2REAL=MPI_2DOUBLE_PRECISION -D__netcdf -D__netcdf4 -D__netcdf4_parallel
%make_options -j 8
%c_compiler_options      -Ofast -Wno-format -Wno-unused-result
%compiler_options_rrtmg -O2 -I/opt/netcdf-fortran-flang/include
%compiler_options -O2 -fopenacc --offload-arch=gfx936 -I/opt/netcdf-fortran-flang/include
%linker_options_rrtmg -O2 -L/opt/netcdf-fortran-flang/lib -lnetcdff -L/opt/netcdf-parallel/lib -lnetcdf -Wl,-rpath,/opt/mpi-flang/lib -Wl,-rpath,/opt/netcdf-fortran-flang/lib -Wl,-rpath,/opt/netcdf-parallel/lib
%linker_options -L/opt/dtk-26.04/hipfft/lib -lhipfft -lamdhip64 -Wl,-rpath,/opt/dtk-26.04/hipfft/lib -O2 -fopenacc --offload-arch=gfx936 -I/opt/netcdf-fortran-flang/include -L/opt/netcdf-fortran-flang/lib -lnetcdff -L/opt/netcdf-parallel/lib -lnetcdf -Wl,-rpath,/opt/mpi-flang/lib -Wl,-rpath,/opt/netcdf-fortran-flang/lib -Wl,-rpath,/opt/netcdf-parallel/lib
%execute_command /opt/mpi-flang/bin/mpirun --allow-run-as-root --mca coll ^hcoll -n {{mpi_tasks}} ./palm
%execute_command_for_combine env OMP_NUM_THREADS=1 /opt/mpi-flang/bin/mpirun --allow-run-as-root --mca coll ^hcoll -n 1 ./combine_plot_fields.x
IC:ulimit  -s unlimited
EC:[[ $locat = execution ]]  &&  cat  RUN_CONTROL
OC:[[ -f LIST_PROFIL_1D     ]]  &&  cat  LIST_PROFIL_1D  >>  LIST_PROFILE
OC:[[ -f LIST_PROFIL        ]]  &&  cat  LIST_PROFIL     >>  LIST_PROFILE
OC:[[ -f PARTICLE_INFOS/_0000 ]]  &&  cat  PARTICLE_INFOS/* >> PARTICLE_INFO
